<question type="category"><category><text>$course$/Mathematics/Algebra</text></category></question>
<question type="cloze">
<name><text>Linear equation [001]</text></name>
<questiontext format="html">
<text>
<![CDATA[

        
        <p>Solve -4x + 7 = -29.</p><p>x = {1:NM:=9}</p>
        
]]>
</text></questiontext>

<generalfeedback format="html">
<text>
<![CDATA[
<p>Subtract 7 and divide by -4: x = (-29 - 7) / -4 = 9.</p>
]]>
</text></generalfeedback>

<penalty>0.5</penalty><hidden>0</hidden>
<tags>
<tag><text>linear-equations</text></tag>
</tags>
</question>
<question type="cloze">
<name><text>Linear equation [002]</text></name>
<questiontext format="html">
<text>
<![CDATA[

        
        <p>Solve 10x - 7 = 93.</p><p>x = {1:NM:=10}</p>
        
]]>
</text></questiontext>

<generalfeedback format="html">
<text>
<![CDATA[
<p>Subtract -7 and divide by 10: x = (93 - -7) / 10 = 10.</p>
]]>
</text></generalfeedback>

<penalty>0.5</penalty><hidden>0</hidden>
<tags>
<tag><text>linear-equations</text></tag>
</tags>
</question>
<question type="category"><category><text>$course$/Finance/Compound interest</text></category></question>
<question type="cloze">
<name><text>Compound interest [001]</text></name>
<questiontext format="html">
<text>
<![CDATA[

        
        <p>Invest $49,500.00 at 9.8% annually, compounded once a year, for 14 years.</p><p>Find the final amount in dollars: {1:NM:=183247.46:183.24746}</p>
        
]]>
</text></questiontext>

<generalfeedback format="html">
<text>
<![CDATA[
<p>A = P(1 + r)<sup>t</sup> = 49500(1 + 0.098)<sup>14</sup> = $183,247.46.</p>
]]>
</text></generalfeedback>

<penalty>0.5</penalty><hidden>0</hidden>
<tags>
<tag><text>annual-compounding</text></tag>
</tags>
</question>
