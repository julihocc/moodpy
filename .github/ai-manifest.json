{
  "name": "moodpy",
  "version": "3.0.1",
  "type": "python-library",
  "description": "Collaborative, reproducible parametric Moodle question-bank authoring",
  "entrypoint": "AGENTS.md",
  "authoring_guide": "docs/authoring-guide.md",
  "verified_recipes": "docs/verified-recipes.md",
  "template": "examples/agent_workflow/author_bank.py",
  "capabilities": [
    "parametric-cloze-numerical",
    "parametric-cloze-shortanswer",
    "seeded-family-generation",
    "topic-categories",
    "teacher-preview",
    "local-validation",
    "reusable-bank-bundle"
  ],
  "public_api": [
    "QuestionFamily",
    "build_bank",
    "QuestionBank.validate",
    "QuestionBank.export_bundle"
  ],
  "execution": "Python in an accessible workspace; no API key or submodule required",
  "limitations": [
    "Trusted executable Python recipes",
    "Local checks are not a live Moodle import",
    "Legacy examples require verification",
    "Quiz activities are configured in Moodle"
  ],
  "repository": {
    "url": "https://github.com/julihocc/moodpy",
    "branch": "main"
  }
}
